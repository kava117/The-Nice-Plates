# Copy to .env in the project root. Every line is optional locally; each one turns on a feature.

# Signs login cookies. Required on Render. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Google sign-in. Without these everyone is the shared Sample User.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# /api/transcribe (recording -> text)
OPENAI_API_KEY=

# Photo and PDF uploads on a small server: set PHOTO_UPLOADS=off and an Anthropic key,
# and Claude reads the score instead of homr (which needs about 1 GB of memory).
PHOTO_UPLOADS=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# CLAUDE_MODEL=claude-sonnet-5-5   (leave commented out to use the default; an empty value breaks it)

# homr on its own box (homr_service/, on Azure). Photos and PDFs go there first, and to Claude
# (with the key above) when it can't read them. See "homr on Azure" in the README.
HOMR_URL=
HOMR_TOKEN=
